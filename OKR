            document.getElementById('update-proj-id').value = project.id;
            document.getElementById('updateModalTitle').innerText = `อัปเดต: ${project.name}`;
            document.getElementById('updateModalSubtitle').innerText = `${project.deptName} • หัวหน้า: ${project.head}`;
            document.getElementById('update-progress-range').value = project.progress;
            document.getElementById('progress-val-text').innerText = project.progress + '%';
            document.getElementById('update-status').value = project.status;
            document.getElementById('update-bottleneck').value = project.bottleneck === '-' ? '' : project.bottleneck;

            document.getElementById('updateProgressModal').style.display = 'flex';
        }

        function closeUpdateModal() {
            document.getElementById('updateProgressModal').style.display = 'none';
        }

        function saveProjectProgress() {
            const projId = parseInt(document.getElementById('update-proj-id').value);
            const project = mockProjectsList.find(p => p.id === projId);
            if (!project) return;

            const newProgress = parseInt(document.getElementById('update-progress-range').value);
            const newStatus = document.getElementById('update-status').value;
            const newBottleneck = document.getElementById('update-bottleneck').value.trim() || '-';

            project.progress = newProgress;
            project.status = newStatus;
            project.bottleneck = newBottleneck;

            if (newStatus === 'บรรลุเป้าหมาย' || newProgress === 100) {
                project.statusClass = 'status-success';
                project.icon = 'fa-check';
            } else if (newStatus === 'ติดปัญหา/ล่าช้า') {
                project.statusClass = 'status-danger';
                project.icon = 'fa-triangle-exclamation';
            } else {
                project.statusClass = 'status-progress';
                project.icon = 'fa-spinner';
            }

            closeUpdateModal();
            alert(`✅ บันทึกความคืบหน้าของโครงการ "${project.name}" สำเร็จ!`);
            renderTrackCards();
            filterProjectsTable();
            updateDashboardData();
        }

        // ================= FUNCTION: กำหนดผู้รับผิดชอบโครงการ =================
        function renderAssignRolesTable() {
            const tbody = document.getElementById('assign-roles-table-body');
            if (!tbody) return;
            tbody.innerHTML = '';

            mockProjectsList.forEach(p => {
                const tr = document.createElement('tr');
                const headOptions = mockTeacherList.map(t => `<option value="${t}" ${t === p.head ? 'selected' : ''}>${t}</option>`).join('');
                
                tr.innerHTML = `
                    <td style="font-weight:600; color:var(--primary);">${p.name}</td>
                    <td><span style="background:#f1f5f9; padding:4px 8px; border-radius:4px; font-size:12px;">${p.deptName}</span></td>
                    <td>
                        <select id="head-select-${p.id}" style="padding:6px 10px; border-radius:6px; border:1.5px solid #cbd5e1; font-family:'Prompt'; font-size:13px; width:100%;" ${currentRole==='teacher'||currentRole==='staff'?'disabled':''}>
                            ${headOptions}
                        </select>
                    </td>
                    <td>
                        <input type="text" id="assignees-input-${p.id}" value="${p.assignees.join(', ')}" placeholder="เช่น อ. สมชาย, น.ส. ธนพร" style="padding:6px 10px; border-radius:6px; border:1.5px solid #cbd5e1; font-family:'Prompt'; font-size:13px; width:100%;">
                    </td>
                    <td>
                        <button class="btn-action-primary" style="padding:6px 14px; font-size:12px;" onclick="saveAssignment(${p.id})"><i class="fa-solid fa-floppy-disk"></i> บันทึก</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function saveAssignment(projId) {
            const project = mockProjectsList.find(p => p.id === projId);
            if (!project) return;

            const newHead = document.getElementById(`head-select-${projId}`).value;
            const newAssigneesText = document.getElementById(`assignees-input-${projId}`).value;

            project.head = newHead;
            project.assignees = newAssigneesText ? newAssigneesText.split(',').map(s => s.trim()).filter(s => s.length > 0) : [];

            alert(`🎉 บันทึกการมอบหมายผู้รับผิดชอบโครงการ "${project.name}" เรียบร้อยแล้ว!`);
            filterProjectsTable();
        }

        // ================= FUNCTION: แอดมิน ป้อนข้อมูล OKR =================
        function submitNewOKR() {
            const title = document.getElementById('new-okr-title').value;
            const projectName = document.getElementById('new-project-name').value;
            const mainObj = document.getElementById('new-main-obj').value;
            const subObj = document.getElementById('new-sub-obj').value;
            const deptCode = document.getElementById('new-dept').value;
            const deptName = (deptCode === 'computer' ? 'ภาควิชาคอมพิวเตอร์' : (deptCode === 'chemistry' ? 'ภาควิชาเคมี' : 'ส่วนกลางคณะ'));
            const head = document.getElementById('new-head').value;
            const budgetNum = parseFloat(document.getElementById('new-budget').value) || 0;
            const year = document.getElementById('new-okr-year').value;
            const assigneesText = document.getElementById('new-assignees').value;

            const newProject = {
                id: mockProjectsList.length + 1,
                name: projectName,
                mainObjective: mainObj || title,
                subObjective: subObj || '-',
                head: head,
                assignees: assigneesText ? assigneesText.split(',').map(s => s.trim()) : [],
                deptCode: deptCode,
                deptName: deptName,
                year: year,
                month: '1',
                budget: budgetNum.toLocaleString() + ' ฿',
                spent: '0 ฿ (0%)',
                progress: 0,
                status: 'กำลังดำเนินการ',
                statusClass: 'status-progress',
                icon: 'fa-spinner',
                bottleneck: '-',
                evidences: []
            };

            mockProjectsList.unshift(newProject);
            alert(`🎉 ป้อนข้อมูลโครงการ "${projectName}" เข้าระบบฐานข้อมูล OKR เรียบร้อยแล้ว!`);
            switchTab('projects');
        }

        function togglePerm(btn) {
            if (btn.classList.contains('perm-granted')) {
                btn.classList.remove('perm-granted');
                btn.classList.add('perm-revoked');
                btn.innerHTML = '<i class="fa-solid fa-lock"></i> ระงับสิทธิ์ชั่วคราว';
                alert('ระงับสิทธิ์การเข้าถึงของผู้บริหารรายนี้แล้ว');
            } else {
                btn.classList.remove('perm-revoked');
                btn.classList.add('perm-granted');
                btn.innerHTML = '<i class="fa-solid fa-lock-open"></i> มีสิทธิ์เข้าถึง';
                alert('เปิดใช้งานสิทธิ์การเข้าถึงของผู้บริหารเรียบร้อยแล้ว');
            }
        }

        function openProjectModal(projectId) {
            const project = mockProjectsList.find(p => p.id === projectId);
            if (!project) return;

            document.getElementById('modalProjectName').innerText = project.name;
            document.getElementById('modalProjectDept').innerText = `${project.deptName} • ปีการศึกษา ${project.year}`;
            document.getElementById('modalMainObj').innerText = project.mainObjective || '-';
            document.getElementById('modalSubObj').innerText = project.subObjective || '-';
            document.getElementById('modalHead').innerText = project.head;
            
            const assigneesText = (project.assignees && project.assignees.length > 0) ? project.assignees.join(', ') : 'ไม่มีผู้ร่วมงานระบุ';
            document.getElementById('modalAssignees').innerText = assigneesText;
            
            document.getElementById('modalBudget').innerText = `งบประมาณตั้งต้น: ${project.budget} | เบิกจ่ายแล้ว: ${project.spent}`;
            document.getElementById('modalProgress').innerHTML = `
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:5px;">
                    <span>ความก้าวหน้า: <b>${project.progress}%</b></span>
                    <span class="status-badge ${project.statusClass}"><i class="fa-solid ${project.icon}"></i> ${project.status}</span>
                </div>
                <div class="progress-bar-bg" style="max-width:100%; height:8px;"><div class="progress-bar-fill" style="width:${project.progress}%; background:${project.progress===100?'var(--success)':'var(--secondary)'};"></div></div>
            `;

            const bottleneckGroup = document.getElementById('modalBottleneckGroup');
            if (project.bottleneck && project.bottleneck !== '-') {
                bottleneckGroup.style.display = 'block';
                document.getElementById('modalBottleneck').innerText = project.bottleneck;
            } else {
                bottleneckGroup.style.display = 'none';
            }

            const evidencesContainer = document.getElementById('modalEvidences');
            if (project.evidences && project.evidences.length > 0) {
                evidencesContainer.innerHTML = project.evidences.map(file => `
                    <a href="javascript:void(0)" class="evidence-tag" onclick="alert('ดาวน์โหลด/เปิดดูไฟล์: ${file}')"><i class="fa-solid fa-file-lines"></i> ${file}</a>
                `).join('');
            } else {
                evidencesContainer.innerHTML = '<span style="color:#94a3b8; font-size:13px;">ยังไม่มีการแนบหลักฐาน</span>';
            }

            document.getElementById('projectModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('projectModal').style.display = 'none';
        }

        function initCharts() {
            if (typeof Chart === 'undefined') return;
            Chart.defaults.font.family = "'Prompt', sans-serif";

            if (!donutChartInstance) {
                const ctxDonut = document.getElementById('donutChart').getContext('2d');
                donutChartInstance = new Chart(ctxDonut, {
                    type: 'doughnut',
                    data: { labels: ['บรรลุเป้าหมาย', 'กำลังดำเนินการ', 'ติดปัญหา/ล่าช้า', 'พักชะลอ'], datasets: [{ data: [], backgroundColor: ['#10b981', '#3b82f6', '#f59e0b', '#ef4444'], borderWidth: 0 }] },
                    options: { responsive: true, maintainAspectRatio: false, cutout: '75%', plugins: { legend: { position: 'bottom' } } }
                });
            }

            if (!barChartInstance) {
                const ctxBar = document.getElementById('barChart').getContext('2d');
                barChartInstance = new Chart(ctxBar, {
                    type: 'bar',
                    data: { labels: ['งานวิจัย', 'วิชาการ', 'บริการสังคม', 'พัฒนานิสิต', 'บริหารองค์กร'], datasets: [{ data: [], backgroundColor: '#3b82f6', borderRadius: 6 }] },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
                });
            }
        }

        function renderExecDashboard(year) {
            if (typeof Chart === 'undefined') return;
            const overall = mockSummaryData[year]['all'];
            const comp = mockSummaryData[year]['computer'];
            const chem = mockSummaryData[year]['chemistry'];

            document.getElementById('sum-remaining').innerText = (overall.budget - overall.spentAmount).toFixed(2);

            if (!trendChartInstance) {
                const ctxTrend = document.getElementById('trendChart').getContext('2d');
                trendChartInstance = new Chart(ctxTrend, {
                    type: 'line',
                    data: { labels: ['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'], datasets: [{ label: 'ความคืบหน้า (%)', data: overall.trend, borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,0.1)', fill: true, tension: 0.3 }] },
                    options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, max: 100 } } }
                });
            } else {
                trendChartInstance.data.datasets[0].data = overall.trend;
                trendChartInstance.update();
            }

            const compSpentPct = (comp.spentAmount / comp.budget * 100).toFixed(1);
            const chemSpentPct = (chem.spentAmount / chem.budget * 100).toFixed(1);
            if (!compareChartInstance) {
                const ctxCompare = document.getElementById('compareChart').getContext('2d');
                compareChartInstance = new Chart(ctxCompare, {
                    type: 'bar',
                    data: {
                        labels: ['คอมพิวเตอร์', 'เคมี'],
                        datasets: [
                            { label: 'ความคืบหน้า (%)', data: [parseFloat(comp.progress), parseFloat(chem.progress)], backgroundColor: '#3b82f6', borderRadius: 6 },
                            { label: 'งบที่ใช้ไป (%)', data: [compSpentPct, chemSpentPct], backgroundColor: '#f59e0b', borderRadius: 6 }
                        ]
                    },
                    options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, max: 100 } } }
                });
            } else {
                compareChartInstance.data.datasets[0].data = [parseFloat(comp.progress), parseFloat(chem.progress)];
                compareChartInstance.data.datasets[1].data = [compSpentPct, chemSpentPct];
                compareChartInstance.update();
            }

            document.getElementById('dept-compare-body').innerHTML = `
                <tr><td style="font-weight:600; color:var(--primary);">คอมพิวเตอร์</td><td>${comp.progress}</td><td>${comp.budget} ลบ.</td><td>${comp.spentAmount} ลบ.</td><td>${(comp.budget - comp.spentAmount).toFixed(2)} ลบ.</td><td><span style="color:${comp.riskColor}; font-weight:600;">${comp.risk}</span></td></tr>
                <tr><td style="font-weight:600; color:var(--primary);">เคมี</td><td>${chem.progress}</td><td>${chem.budget} ลบ.</td><td>${chem.spentAmount} ลบ.</td><td>${(chem.budget - chem.spentAmount).toFixed(2)} ลบ.</td><td><span style="color:${chem.riskColor}; font-weight:600;">${chem.risk}</span></td></tr>
            `;

            const riskList = mockProjectsList.filter(p => p.year === year && p.statusClass === 'status-danger');
            const riskContainer = document.getElementById('risk-project-list');
            if (riskList.length === 0) {
                riskContainer.innerHTML = '<p style="color: var(--text-light); padding: 10px 0;"><i class="fa-solid fa-circle-check" style="color:var(--success);"></i> ยอดเยี่ยม! ไม่มีโครงการที่มีความเสี่ยงในเงื่อนไขเวลานี้</p>';
            } else {
                riskContainer.innerHTML = riskList.map(p => `
                    <div style="display:flex; justify-content:space-between; align-items:center; padding:14px 0; border-bottom:1px solid #f1f5f9;">
                        <div>
                            <div style="font-weight:600; color:var(--primary);">${p.name}</div>
                            <div style="font-size:13px; color:var(--text-light); margin-top:2px;">${p.deptName} • ผู้รับผิดชอบ: ${p.head}</div>
                            <div style="font-size:12px; color:var(--danger); margin-top:4px;"><i class="fa-solid fa-circle-exclamation"></i> <b>คอขวด/ปัญหา:</b> ${p.bottleneck}</div>
                        </div>
                        <span class="status-badge status-danger">คืบหน้า ${p.progress}%</span>
                    </div>`).join('');
            }
        }

        function exportPDF() {
            window.print();
        }
    </script>
</body>
</html>
