        function filterProjectsTable() {
            const filterYear = document.getElementById('filter-year').value;
            const filterDept = document.getElementById('filter-dept').value;
            const filterMonth = document.getElementById('filter-month').value;
            const searchText = (document.getElementById('table-search') ? document.getElementById('table-search').value.toLowerCase().trim() : '');
            const statusFilter = (document.getElementById('table-status-filter') ? document.getElementById('table-status-filter').value : 'all');

            const tbody = document.getElementById('projects-table-body');
            if (!tbody) return;
            tbody.innerHTML = '';

            const filteredProjects = mockProjectsList.filter(p => {
                const matchYear = (p.year === filterYear);
                const matchDept = (filterDept === 'all' || p.deptCode === filterDept || p.deptCode === 'all');
                const matchMonth = (filterMonth === 'all' || p.month === filterMonth || p.month === 'all');
                const matchSearch = (p.name.toLowerCase().includes(searchText) || p.head.toLowerCase().includes(searchText) || p.deptName.toLowerCase().includes(searchText));
                const matchStatus = (statusFilter === 'all' || p.status === statusFilter);
                return matchYear && matchDept && matchMonth && matchSearch && matchStatus;
            });

            if (filteredProjects.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; padding: 35px; color: #94a3b8;"><i class="fa-regular fa-folder-open" style="font-size:24px; margin-bottom:8px; display:block;"></i>ไม่พบข้อมูลโครงการตามเงื่อนไขที่เลือก</td></tr>';
                return;
            }

            filteredProjects.forEach(p => {
                const avatarText = p.head.split(' ').pop().substring(0, 2);
                const tr = document.createElement('tr');
                tr.onclick = () => openProjectModal(p.id);
                tr.innerHTML = `
                    <td style="font-weight: 600; color: var(--primary);">${p.name}</td>
                    <td><div class="table-avatar"><div class="circle">${avatarText}</div><span>${p.head}</span></div></td>
                    <td><span style="background: #f1f5f9; padding: 4px 8px; border-radius: 6px; font-size: 12px; font-weight:500;">${p.deptName}</span></td>
                    <td>${p.budget}</td>
                    <td>${p.spent}</td>
                    <td>
                        <div class="progress-wrapper">
                            <div class="progress-bar-bg"><div class="progress-bar-fill" style="width: ${p.progress}%; background: ${p.progress === 100 ? 'var(--success)' : 'var(--secondary)'};"></div></div> 
                            <span class="progress-text">${p.progress}%</span>
                        </div>
                    </td>
                    <td><span class="status-badge ${p.statusClass}"><i class="fa-solid ${p.icon}"></i> ${p.status}</span></td>
                    <td><button class="btn-view-detail" onclick="event.stopPropagation(); openProjectModal(${p.id})"><i class="fa-regular fa-eye"></i> ดูข้อมูล</button></td>
                `;
                tbody.appendChild(tr);
            });
        }

