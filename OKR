        // ================= FUNCTION: อาจารย์ทั่วไป - แก้ไขข้อมูล OKR =================
        function openEditOKRModal(projId) {
            const project = mockProjectsList.find(p => p.id === projId);
            if (!project) return;

            document.getElementById('edit-proj-id').value = project.id;
            document.getElementById('editOKRModalTitle').innerHTML = `<i class="fa-solid fa-pen-to-square" style="color:var(--warning);"></i> แก้ไขข้อมูลโครงการ OKR: ${project.name}`;
            document.getElementById('editOKRModalSubtitle').innerText = `${project.deptName} • ผู้รับผิดชอบหลัก: ${project.head}`;
            document.getElementById('edit-proj-name').value = project.name;
            document.getElementById('edit-sub-obj').value = project.subObjective || '';
            document.getElementById('edit-spent-text').value = project.spent || '';
            document.getElementById('edit-bottleneck').value = project.bottleneck === '-' ? '' : project.bottleneck;

            document.getElementById('editOKRModal').style.display = 'flex';
        }

        function closeEditOKRModal() {
            document.getElementById('editOKRModal').style.display = 'none';
        }

        function saveEditedOKR() {
            const projId = parseInt(document.getElementById('edit-proj-id').value);
            const project = mockProjectsList.find(p => p.id === projId);
            if (!project) return;

            project.name = document.getElementById('edit-proj-name').value;
            project.subObjective = document.getElementById('edit-sub-obj').value;
            project.spent = document.getElementById('edit-spent-text').value || project.spent;
            project.bottleneck = document.getElementById('edit-bottleneck').value.trim() || '-';

            closeEditOKRModal();
            alert(`✅ บันทึกการแก้ไขข้อมูล OKR โครงการ "${project.name}" เรียบร้อยแล้ว!`);
            renderMyProjectsTable();
            filterProjectsTable();
            renderTrackCards();
        }

        // ================= FUNCTION: อาจารย์ทั่วไป - อัปโหลดหลักฐาน =================
        function renderUploadEvidenceView(targetProjId = null) {
            const select = document.getElementById('upload-select-project');
            if (!select) return;
            select.innerHTML = '';

            const myProjects = mockProjectsList.filter(p => 
                p.head.includes(currentUserName) || 
                p.assignees.some(a => a.includes(currentUserName))
            );

            const displayList = (myProjects.length > 0) ? myProjects : mockProjectsList;

            displayList.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.id;
                opt.innerText = `[${p.deptName}] ${p.name} (ปี ${p.year})`;
                if (targetProjId && p.id === targetProjId) opt.selected = true;
                select.appendChild(opt);
            });

            renderEvidenceHistory();
        }

        function goToUploadEvidence(projId) {
            switchTab('upload-evidence');
            renderUploadEvidenceView(projId);
        }

        function submitUploadEvidence() {
            const projId = parseInt(document.getElementById('upload-select-project').value);
            const fileLabel = document.getElementById('upload-file-label').value.trim();
            const project = mockProjectsList.find(p => p.id === projId);

            if (!project || !fileLabel) return;

            if (!project.evidences) project.evidences = [];
            project.evidences.push(fileLabel);

            alert(`🎉 อัปโหลดไฟล์ "${fileLabel}" เข้าสู่โครงการ "${project.name}" เรียบร้อยแล้ว!`);
            
            document.getElementById('upload-file-label').value = '';
            document.getElementById('upload-file-input').value = '';
            document.getElementById('upload-description').value = '';

            renderEvidenceHistory();
        }

