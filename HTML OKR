        // ================= FUNCTION: หัวหน้า OKR กระจายรายงานสู่ทีมงาน =================
        function initShareReportsView() {
            const select = document.getElementById('share-report-project');
            if (!select) return;
            select.innerHTML = '';

            mockProjectsList.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.name;
                opt.innerText = `[${p.deptName}] ${p.name}`;
                select.appendChild(opt);
            });

            renderBroadcastHistory();
        }

        function submitBroadcastReport() {
            const title = document.getElementById('share-report-title').value.trim();
            const projName = document.getElementById('share-report-project').value;
            const fileInput = document.getElementById('share-report-file');
            const fileName = fileInput.files[0] ? fileInput.files[0].name : 'เอกสารรายงาน_OKR.pdf';
            const message = document.getElementById('share-report-message').value.trim();

            const recipients = [];
            if (document.getElementById('rec-teacher').checked) recipients.push('อาจารย์ทั่วไป');
            if (document.getElementById('rec-other-head').checked) recipients.push('หัวหน้า OKR อื่น');
            if (document.getElementById('rec-staff').checked) recipients.push('บุคลากรทั่วไป');

            if (recipients.length === 0) {
                alert('กรุณาเลือกกลุ่มผู้รับเอกสารอย่างน้อย 1 กลุ่ม');
                return;
            }

            const newBroadcast = {
                id: Date.now(),
                title: title,
                projectName: projName,
                sender: currentUserName,
                fileName: fileName,
                recipients: recipients.join(', '),
                date: 'วันนี้',
                message: message || '-'
            };

            mockSharedBroadcasts.unshift(newBroadcast);

            alert(`🎉 กระจายไฟล์รายงาน "${fileName}" เรียบร้อย!\n\nส่งถึงกลุ่ม: ${recipients.join(', ')}\n(ทุกคนที่ไม่ใช่ผู้บริหารสามารถเปิดดูและดาวน์โหลดเอกสารนี้ได้ทันทีในกล่องเอกสาร)`);

            document.getElementById('share-report-title').value = '';
            document.getElementById('share-report-file').value = '';
            document.getElementById('share-report-message').value = '';

            renderBroadcastHistory();
        }

        function renderBroadcastHistory() {
            const tbody = document.getElementById('broadcast-history-body');
