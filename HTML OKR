                    : '<span class="status-badge status-pending"><i class="fa-solid fa-hourglass-half"></i> รอการตรวจสอบ</span>';

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td style="font-weight:600; color:var(--primary); max-width:200px;">
                        ${sub.projectName}
                        <div style="font-size:12px; color:var(--text-light); font-weight:normal;">ปัจจุบันคืบหน้า: <b>${currentProg}%</b></div>
                    </td>
                    <td>
                        <a href="javascript:void(0)" class="evidence-tag" onclick="alert('เปิดดูเอกสาร: ${sub.fileName}')"><i class="fa-solid fa-file-lines"></i> ${sub.fileName}</a>
                        <div style="font-size:12.5px; color:#475569; margin-top:4px;">${sub.description || '-'}</div>
                    </td>
                    <td><span style="font-weight:500;">${sub.uploadedBy}</span></td>
                    <td style="font-size:13px; color:var(--text-light);">${sub.uploadDate}</td>
                    <td style="min-width:140px;">
                        <div style="display:flex; align-items:center; gap:8px;">
                            <input type="number" id="eval-progress-${sub.id}" min="0" max="100" value="${sub.assessedProgress}" style="width:70px; padding:6px 8px; border:1.5px solid #cbd5e1; border-radius:6px; font-weight:700; color:var(--primary); text-align:center;">
                            <span style="font-weight:600; color:var(--primary);">%</span>
                        </div>
                    </td>
                    <td>${statusBadge}</td>
                    <td>
                        <button class="btn-action-primary" style="padding:7px 14px; font-size:12px;" onclick="submitEvidenceAssessment(${sub.id})"><i class="fa-solid fa-check"></i> ยืนยันหลักฐาน</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function submitEvidenceAssessment(submissionId) {
            const sub = mockEvidenceSubmissions.find(s => s.id === submissionId);
            if (!sub) return;

            const inputElem = document.getElementById(`eval-progress-${submissionId}`);
            const assessedVal = inputElem ? parseInt(inputElem.value) : sub.assessedProgress;

            sub.assessedProgress = assessedVal;
            sub.status = 'อนุมัติแล้ว';

            const project = mockProjectsList.find(p => p.id === sub.projectId);
            if (project) {
                project.progress = assessedVal;
                if (!project.evidences) project.evidences = [];
                if (!project.evidences.includes(sub.fileName)) project.evidences.push(sub.fileName);
            }

            alert(`🎉 ตรวจสอบและยืนยันหลักฐาน "${sub.fileName}" เรียบร้อย!\nพร้อมนำไปสรุปใน Dashboard โครงการเพื่อส่งต่อให้ผู้บริหาร`);
            renderVerifyEvidenceTable();
        }

