        // ================= FUNCTION: หัวหน้า OKR สร้าง Dashboard ส่งผู้บริหาร =================
        function initHeadDashboardBuilder() {
            const select = document.getElementById('head-dash-proj-select');
            if (!select) return;
            select.innerHTML = '';

            const myProjects = mockProjectsList.filter(p => p.head.includes(currentUserName) || currentRole === 'head_okr');
            const displayList = (myProjects.length > 0) ? myProjects : mockProjectsList;

            displayList.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.id;
                opt.innerText = `[${p.deptName}] ${p.name} (คืบหน้าปัจจุบัน ${p.progress}%)`;
                select.appendChild(opt);
            });

            autoFillHeadDashboardBuilder();
        }

        function autoFillHeadDashboardBuilder() {
            const select = document.getElementById('head-dash-proj-select');
            if (!select || !select.value) return;
            const p = mockProjectsList.find(item => item.id === parseInt(select.value));
            if (!p) return;

            document.getElementById('head-dash-progress').value = p.progress;
            document.getElementById('head-dash-status').value = p.status;
            document.getElementById('head-dash-highlights').value = `ผลสัมฤทธิ์ตามตัวชี้วัด: ${p.subObjective}`;
            document.getElementById('head-dash-bottleneck').value = p.bottleneck;
        }

        function submitDashboardToExecutive() {
            const select = document.getElementById('head-dash-proj-select');
            const projId = parseInt(select.value);
            const project = mockProjectsList.find(p => p.id === projId);
            if (!project) return;

            const newProgress = parseInt(document.getElementById('head-dash-progress').value) || 0;
            const newStatus = document.getElementById('head-dash-status').value;
            const highlights = document.getElementById('head-dash-highlights').value;
            const bottleneck = document.getElementById('head-dash-bottleneck').value.trim() || '-';

            project.progress = newProgress;
            project.status = newStatus;
            project.subObjective = highlights;
            project.bottleneck = bottleneck;

            if (newStatus === 'บรรลุเป้าหมาย' || newProgress === 100) {
                project.statusClass = 'status-success';
                project.icon = 'fa-check';
            } else if (newStatus === 'ติดปัญหา/ล่าช้า') {
                project.statusClass = 'status-danger';
                project.icon = 'fa-triangle-exclamation';
            } else {
                project.statusClass = 'status-progress';
                project.icon = 'fa-spinner';
            }

            alert(`🚀 จัดทำและส่งข้อมูล Dashboard โครงการ "${project.name}" ให้ผู้บริหารเรียบร้อยแล้ว!\n\nข้อมูลความคืบหน้านี้จะปรากฏในหน้า "Dashboard ติดตามรายโครงการ" ของผู้บริหารทันที`);
            filterProjectsTable();
        }

