                const matchDept = (filterDept === 'all' || p.deptCode === filterDept || p.deptCode === 'all');
                const matchMonth = (filterMonth === 'all' || p.month === filterMonth || p.month === 'all');
                const matchSearch = (p.name.toLowerCase().includes(searchText) || p.head.toLowerCase().includes(searchText) || p.deptName.toLowerCase().includes(searchText));
